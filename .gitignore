# dependencies (reinstalled from package-lock.json, never committed)
node_modules/

# build output (regenerated by `npm run build`)
dist/

# test coverage reports (regenerated by `npm run test:coverage`)
coverage/

# SQLite database files (created at runtime; each dev gets their own)
*.db
*.db-journal
*.db-wal
*.db-shm

# environment / editor / OS noise
.env
.claude/
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.log

# the assignment brief itself is not part of the deliverable
Backend_Engineer_Tech_questions_assignment.pdf

# personal interview notes (local only)
INTERVIEW_PREP.md
