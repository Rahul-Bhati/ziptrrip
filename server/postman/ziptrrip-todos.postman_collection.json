{
  "info": {
    "name": "Ziptrrip Todo API",
    "description": "CRUD API for the Ziptrrip todo app.\n\n1. Start the server: `npm run dev` (in /server)\n2. Import this collection into Postman\n3. Run requests in order, or use the Collection Runner to run them all with their tests.\n\n\"Create a todo\" saves the new id into the `todoId` collection variable, which later requests use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "todoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status is ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Todos CRUD",
      "item": [
        {
          "name": "Create a todo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/todos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Buy milk\",\n  \"description\": \"2 litres, full cream\",\n  \"priority\": \"high\",\n  \"dueDate\": \"2026-10-10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const todo = pm.response.json().data;",
                  "pm.test(\"Returns the created todo\", () => { pm.expect(todo.title).to.eql(\"Buy milk\"); pm.expect(todo.completed).to.eql(false); });",
                  "pm.test(\"Location header points to the new todo\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/todos/\" + todo.id));",
                  "pm.collectionVariables.set(\"todoId\", todo.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a todo (title only, defaults applied)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/todos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Walk the dog\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const todo = pm.response.json().data;",
                  "pm.test(\"Defaults applied\", () => { pm.expect(todo.priority).to.eql(\"medium\"); pm.expect(todo.dueDate).to.eql(null); pm.expect(todo.description).to.eql(\"\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List all todos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns a list and stats\", () => { pm.expect(body.data).to.be.an(\"array\"); pm.expect(body.stats).to.have.keys(\"total\", \"active\", \"completed\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List active todos, highest priority first",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos?status=active&sortBy=priority&order=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "active"
                },
                {
                  "key": "sortBy",
                  "value": "priority"
                },
                {
                  "key": "order",
                  "value": "desc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Only active todos\", () => pm.response.json().data.forEach(t => pm.expect(t.completed).to.eql(false)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search todos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos?search=milk",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "milk"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Every result matches 'milk'\", () => pm.response.json().data.forEach(t => pm.expect((t.title + \" \" + t.description).toLowerCase()).to.include(\"milk\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one todo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos/{{todoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "{{todoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns the requested todo\", () => pm.expect(String(pm.response.json().data.id)).to.eql(String(pm.collectionVariables.get(\"todoId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit title and remove due date",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/todos/{{todoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "{{todoId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Buy oat milk\",\n  \"dueDate\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const todo = pm.response.json().data;",
                  "pm.test(\"Fields updated, others kept\", () => { pm.expect(todo.title).to.eql(\"Buy oat milk\"); pm.expect(todo.dueDate).to.eql(null); pm.expect(todo.priority).to.eql(\"high\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark as completed",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/todos/{{todoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "{{todoId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"completed\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Completed\", () => pm.expect(pm.response.json().data.completed).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete one todo",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos/{{todoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "{{todoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the deleted todo (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos/{{todoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "{{todoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Error code is NOT_FOUND\", () => pm.expect(pm.response.json().error.code).to.eql(\"NOT_FOUND\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete all completed todos",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos/completed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "completed"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns the deleted count\", () => pm.expect(pm.response.json().data.deleted).to.be.a(\"number\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Error cases",
      "item": [
        {
          "name": "Validation errors (all reported at once)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/todos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"priority\": \"urgent\",\n  \"dueDate\": \"2026-02-30\",\n  \"extra\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Error code is VALIDATION_ERROR\", () => pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\"));",
                  "pm.test(\"Reports 4 problems\", () => pm.expect(pm.response.json().error.details).to.have.length(4));"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed JSON",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/todos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"title\": \"missing closing brace\"",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Error code is INVALID_JSON\", () => pm.expect(pm.response.json().error.code).to.eql(\"INVALID_JSON\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Empty update",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/todos/{{todoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "{{todoId}}"
              ]
            },
            "description": "Validation runs before the existence check, so this is a 400 even though the todo was deleted.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Error code is VALIDATION_ERROR\", () => pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos/abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "abc"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Error code is VALIDATION_ERROR\", () => pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Error code is NOT_FOUND\", () => pm.expect(pm.response.json().error.code).to.eql(\"NOT_FOUND\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid query params",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos?status=done&sortBy=name",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "done"
                },
                {
                  "key": "sortBy",
                  "value": "name"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Error code is VALIDATION_ERROR\", () => pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown route",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/does-not-exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "does-not-exist"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Error code is ROUTE_NOT_FOUND\", () => pm.expect(pm.response.json().error.code).to.eql(\"ROUTE_NOT_FOUND\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
